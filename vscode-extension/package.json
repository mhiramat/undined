{
  "name": "undine-vscode",
  "displayName": "Undine Review Workstation",
  "description": "Integrated Linux kernel mail and patch review workstation for UndineD",
  "version": "0.1.0",
  "publisher": "undine",
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "Programming Languages",
    "SCM Providers"
  ],
  "main": "./out/src/extension.js",
  "activationEvents": [
    "onView:undine.foldersView",
    "onView:undine.threadsView",
    "onView:undine.headerView",
    "onCommand:undine.refreshFolders",
    "onCommand:undine.syncFolder",
    "onCommand:undine.refreshThreads",
    "onCommand:undine.openPatchDiff",
    "onCommand:undine.openCommitDescription",
    "onCommand:undine.generateReplyDraft",
    "onCommand:undine.importB4",
    "onCommand:undine.applyPatch",
    "onCommand:undine.importPatchStg"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "undine",
          "title": "Undine Review",
          "icon": "media/undine-icon.svg"
        }
      ]
    },
    "views": {
      "undine": [
        {
          "id": "undine.foldersView",
          "name": "Folders",
          "type": "tree"
        },
        {
          "id": "undine.threadsView",
          "name": "Thread Hierarchy",
          "type": "tree"
        },
        {
          "type": "webview",
          "id": "undine.headerView",
          "name": "Message Header"
        }
      ]
    },
    "commands": [
      {
        "command": "undine.refreshFolders",
        "title": "Refresh Folders",
        "category": "Undine",
        "icon": "$(refresh)"
      },
      {
        "command": "undine.syncFolder",
        "title": "Sync Folder",
        "category": "Undine",
        "icon": "$(sync)"
      },
      {
        "command": "undine.refreshThreads",
        "title": "Refresh Threads",
        "category": "Undine",
        "icon": "$(refresh)"
      },
      {
        "command": "undine.openPatchDiff",
        "title": "Open Patch Diff",
        "category": "Undine"
      },
      {
        "command": "undine.openCommitDescription",
        "title": "Open Commit Description",
        "category": "Undine"
      },
      {
        "command": "undine.generateReplyDraft",
        "title": "Generate LKML Reply Draft",
        "category": "Undine",
        "icon": "$(reply)"
      },
      {
        "command": "undine.sendEmail",
        "title": "Send Email Draft",
        "category": "Undine",
        "icon": "$(mail)"
      },
      {
        "command": "undine.importB4",
        "title": "Hydrate Thread via b4",
        "category": "Undine",
        "icon": "$(cloud-download)"
      },
      {
        "command": "undine.applyPatch",
        "title": "Apply Patch to Repository (b4 am)",
        "category": "Undine",
        "icon": "$(git-pull-request)"
      },
      {
        "command": "undine.importPatchStg",
        "title": "Apply Patch to Current StGit Branch (stg import)",
        "category": "Undine",
        "icon": "$(git-commit)"
      },
      {
        "command": "undine.abortApplyPatch",
        "title": "Abort In-Progress Patch Application",
        "category": "Undine"
      },
      {
        "command": "undine.delegateToMe",
        "title": "Delegate Patch to Me (Patchwork)",
        "category": "Undine"
      },
      {
        "command": "undine.searchMessages",
        "title": "Search Messages (FTS5)",
        "category": "Undine",
        "icon": "$(search)"
      },
      {
        "command": "undine.nextMessage",
        "title": "Next Message",
        "category": "Undine"
      },
      {
        "command": "undine.prevMessage",
        "title": "Previous Message",
        "category": "Undine"
      },
      {
        "command": "undine.setMessageTag",
        "title": "Set Message Color Tag",
        "category": "Undine",
        "icon": "$(tag)"
      }
    ],
    "colors": [
      {
        "id": "undine.tag.cl_1",
        "description": "Undine message tag color: Red ($cl_1)",
        "defaults": {
          "dark": "#CC0000",
          "light": "#CC0000",
          "highContrast": "#FF4D4D",
          "highContrastLight": "#B30000"
        }
      },
      {
        "id": "undine.tag.cl_2",
        "description": "Undine message tag color: Blue ($cl_2)",
        "defaults": {
          "dark": "#4D79FF",
          "light": "#3333FF",
          "highContrast": "#668CFF",
          "highContrastLight": "#0000CC"
        }
      },
      {
        "id": "undine.tag.cl_3",
        "description": "Undine message tag color: Green ($cl_3)",
        "defaults": {
          "dark": "#22A022",
          "light": "#006600",
          "highContrast": "#33CC33",
          "highContrastLight": "#005500"
        }
      },
      {
        "id": "undine.tag.cl_4",
        "description": "Undine message tag color: Gray ($cl_4)",
        "defaults": {
          "dark": "#999999",
          "light": "#777777",
          "highContrast": "#BBBBBB",
          "highContrastLight": "#555555"
        }
      },
      {
        "id": "undine.tag.cl_5",
        "description": "Undine message tag color: Purple ($cl_5)",
        "defaults": {
          "dark": "#994DFF",
          "light": "#6600CC",
          "highContrast": "#B380FF",
          "highContrastLight": "#5200A3"
        }
      },
      {
        "id": "undine.tag.cl_6",
        "description": "Undine message tag color: Light green ($cl_6)",
        "defaults": {
          "dark": "#33CC00",
          "light": "#29A300",
          "highContrast": "#4CE600",
          "highContrastLight": "#1F7A00"
        }
      },
      {
        "id": "undine.tag.cl_7",
        "description": "Undine message tag color: Orange ($cl_7)",
        "defaults": {
          "dark": "#FF9900",
          "light": "#D98200",
          "highContrast": "#FFB84D",
          "highContrastLight": "#B36B00"
        }
      },
      {
        "id": "undine.tag.cl_8",
        "description": "Undine message tag color: Pink ($cl_8)",
        "defaults": {
          "dark": "#CC33CC",
          "light": "#B324B3",
          "highContrast": "#E64CE6",
          "highContrastLight": "#8F1D8F"
        }
      },
      {
        "id": "undine.tag.cl_9",
        "description": "Undine message tag color: Light blue ($cl_9)",
        "defaults": {
          "dark": "#33CCFF",
          "light": "#0099CC",
          "highContrast": "#66D9FF",
          "highContrastLight": "#007399"
        }
      },
      {
        "id": "undine.tag.cl_10",
        "description": "Undine message tag color: Yellow ($cl_10)",
        "defaults": {
          "dark": "#FFFF00",
          "light": "#B39B00",
          "highContrast": "#FFFF4D",
          "highContrastLight": "#8F7C00"
        }
      },
      {
        "id": "undine.tag.label1",
        "description": "Undine message tag color: Important ($label1)",
        "defaults": {
          "dark": "#FF2600",
          "light": "#D92000",
          "highContrast": "#FF5938",
          "highContrastLight": "#B31B00"
        }
      },
      {
        "id": "undine.tag.label2",
        "description": "Undine message tag color: Work ($label2)",
        "defaults": {
          "dark": "#FF9900",
          "light": "#D98200",
          "highContrast": "#FFB84D",
          "highContrastLight": "#B36B00"
        }
      },
      {
        "id": "undine.tag.label3",
        "description": "Undine message tag color: Personal ($label3)",
        "defaults": {
          "dark": "#009900",
          "light": "#007A00",
          "highContrast": "#00CC00",
          "highContrastLight": "#005C00"
        }
      },
      {
        "id": "undine.tag.label4",
        "description": "Undine message tag color: To Do ($label4)",
        "defaults": {
          "dark": "#4D79FF",
          "light": "#3333FF",
          "highContrast": "#668CFF",
          "highContrastLight": "#0000CC"
        }
      },
      {
        "id": "undine.tag.label5",
        "description": "Undine message tag color: Later ($label5)",
        "defaults": {
          "dark": "#B34DB3",
          "light": "#993399",
          "highContrast": "#CC66CC",
          "highContrastLight": "#732673"
        }
      },
      {
        "id": "undine.tag.teal",
        "description": "Undine custom message tag color: Teal",
        "defaults": {
          "dark": "#14B8A6",
          "light": "#0D9488",
          "highContrast": "#2DD4BF",
          "highContrastLight": "#0F766E"
        }
      },
      {
        "id": "undine.tag.cyan",
        "description": "Undine custom message tag color: Cyan",
        "defaults": {
          "dark": "#06B6D4",
          "light": "#0891B2",
          "highContrast": "#22D3EE",
          "highContrastLight": "#0E7490"
        }
      },
      {
        "id": "undine.tag.magenta",
        "description": "Undine custom message tag color: Magenta",
        "defaults": {
          "dark": "#EC4899",
          "light": "#DB2777",
          "highContrast": "#F472B6",
          "highContrastLight": "#BE185D"
        }
      },
      {
        "id": "undine.tag.gold",
        "description": "Undine custom message tag color: Gold",
        "defaults": {
          "dark": "#F59E0B",
          "light": "#D97706",
          "highContrast": "#FBBF24",
          "highContrastLight": "#B45309"
        }
      },
      {
        "id": "undine.tag.indigo",
        "description": "Undine custom message tag color: Indigo",
        "defaults": {
          "dark": "#6366F1",
          "light": "#4F46E5",
          "highContrast": "#818CF8",
          "highContrastLight": "#4338CA"
        }
      },
      {
        "id": "undine.tag.coral",
        "description": "Undine custom message tag color: Coral",
        "defaults": {
          "dark": "#F87171",
          "light": "#EF4444",
          "highContrast": "#FCA5A5",
          "highContrastLight": "#DC2626"
        }
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "undine.refreshFolders",
          "when": "view == undine.foldersView",
          "group": "navigation"
        },
        {
          "command": "undine.refreshThreads",
          "when": "view == undine.threadsView",
          "group": "navigation"
        },
        {
          "command": "undine.searchMessages",
          "when": "view == undine.threadsView",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "undine.syncFolder",
          "when": "view == undine.foldersView",
          "group": "inline"
        },
        {
          "command": "undine.syncFolder",
          "when": "view == undine.foldersView",
          "group": "1_sync"
        },
        {
          "command": "undine.generateReplyDraft",
          "when": "view == undine.threadsView && viewItem == message",
          "group": "inline"
        },
        {
          "command": "undine.importB4",
          "when": "view == undine.threadsView && viewItem == message",
          "group": "1_b4"
        },
        {
          "command": "undine.applyPatch",
          "when": "view == undine.threadsView && viewItem == patch",
          "group": "1_b4"
        },
        {
          "command": "undine.importPatchStg",
          "when": "view == undine.threadsView && viewItem == patch",
          "group": "1_b4"
        },
        {
          "command": "undine.setMessageTag",
          "when": "view == undine.threadsView",
          "group": "2_tag"
        }
      ]
    },
    "keybindings": [
      {
        "command": "undine.nextMessage",
        "key": "j",
        "when": "focusedView == undine.threadsView"
      },
      {
        "command": "undine.prevMessage",
        "key": "k",
        "when": "focusedView == undine.threadsView"
      },
      {
        "command": "undine.searchMessages",
        "key": "/",
        "when": "focusedView == undine.threadsView"
      }
    ],
    "configuration": {
      "title": "Undine Review Workstation",
      "properties": {
        "undine.serverUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8080",
          "description": "Base URL of the running UndineD daemon."
        },
        "undine.authTokenPath": {
          "type": "string",
          "default": "~/.local/share/undined/auth_token",
          "description": "Path to the authentication token file generated by UndineD."
        },
        "undine.targetGitRepo": {
          "type": "string",
          "default": "${workspaceFolder}",
          "description": "Target Git repository path for b4/git patch application."
        },
        "undine.tabSize": {
          "type": "number",
          "default": 8,
          "description": "Strict tab size for LKML patch and code display."
        },
        "undine.pollIntervalSeconds": {
          "type": "number",
          "default": 30,
          "description": "Interval in seconds to poll UndineD for mailbox updates (0 to disable)."
        },
        "undine.autoOpenDiff": {
          "type": "boolean",
          "default": false,
          "description": "Automatically open the patch diff editor when selecting a message (default: false, diff is opened on-demand via the Message Header pane)."
        }
      }
    },
    "chatParticipants": [
      {
        "id": "undine",
        "name": "undine",
        "description": "Undine Linux kernel patch review and LKML assistant",
        "commands": [
          {
            "name": "review",
            "description": "Analyze active kernel patch diff against Linux kernel review conventions"
          },
          {
            "name": "summarize",
            "description": "Summarize discussion and review status for the active email thread"
          },
          {
            "name": "draft-reply",
            "description": "Generate an LKML-compliant reply draft with review feedback and trailers"
          }
        ]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "node ./out/test/runTests.js"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^4.1.1",
    "mocha": "^12.0.3",
    "typescript": "^5.4.5"
  },
  "overrides": {
    "glob": "^14.0.6",
    "minimatch": "^11.0.8"
  },
  "allowScripts": {
    "@vscode/vsce-sign@2.1.1": true
  }
}
